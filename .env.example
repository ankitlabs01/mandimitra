# ==============================================================================
# MANDI MITRA AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and configure your actual project credentials.
# Never commit .env.local to source control.
# ==============================================================================

# Application Meta
NEXT_PUBLIC_APP_NAME="Mandi Mitra AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Public Keys (Browser & Server)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Server-Side Secret Key (Never expose to frontend, server-side only)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# NVIDIA NIM / Nemotron AI (Server-Side Only)
# Optional during development. Algorithmic fallbacks active if omitted.
NVIDIA_API_KEY=""
NVIDIA_NIM_ENDPOINT="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="nvidia/llama-3.1-nemotron-70b-instruct"

# Weather API Key (Server-Side Only)
WEATHER_API_KEY=""
